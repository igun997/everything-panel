rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every document lives under the signed-in user's own id. Contents are
    // end-to-end encrypted on the device; the server only ever sees ciphertext.
    // Field types and sizes are capped so one account cannot fill the free quota.
    match /users/{uid}/meta/vault {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'salt', 'iter', 'check', 'checkNonce', 'updatedAt'])
        && request.resource.data.v is int
        && request.resource.data.salt is string && request.resource.data.salt.size() <= 64
        && request.resource.data.iter is int
        && request.resource.data.iter >= 1000 && request.resource.data.iter <= 5000000
        && request.resource.data.check is string && request.resource.data.check.size() <= 256
        && request.resource.data.checkNonce is string && request.resource.data.checkNonce.size() <= 64
        && request.resource.data.updatedAt is int;
    }
    match /users/{uid}/servers/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'nonce', 'ct', 'updatedAt', 'deleted'])
        && request.resource.data.v is int
        && request.resource.data.nonce is string && request.resource.data.nonce.size() <= 64
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 8192
        && request.resource.data.updatedAt is int
        && request.resource.data.deleted is bool;
    }
  }
}
